PORT=4000

# Set to true to use mock data instead of a real database
USE_MOCK_DATA=true

# MySQL connection (only needed when USE_MOCK_DATA=false)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ethereum_airdrop
DB_USER=root
DB_PASSWORD=your_password

# Etherscan API
ETHERSCAN_API_KEY=your_etherscan_api_key
ETHERSCAN_BASE_URL=https://api.etherscan.io/v2/api

# Allowed origin for CORS
CORS_ORIGIN=http://localhost:3000
