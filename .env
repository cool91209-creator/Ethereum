# API Configuration
# Next.js frontend base URL (used by the browser for client-side fetches)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Express backend URL (used by Next.js server-side proxy rewrites)
BACKEND_API_URL=http://localhost:4000

# Set to 'false' to call the real Express backend instead of mock data
NEXT_PUBLIC_USE_MOCKS=false

# API request timeout in milliseconds
NEXT_PUBLIC_API_TIMEOUT=10000

# Default locale
NEXT_PUBLIC_DEFAULT_LOCALE=en
