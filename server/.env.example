PORT=4000

# Set to true to use mock data instead of a real database
USE_MOCK_DATA=true

# PostgreSQL connection (only needed when USE_MOCK_DATA=false)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ethereum_airdrop
DB_USER=postgres
DB_PASSWORD=your_password

# Allowed origin for CORS
CORS_ORIGIN=http://localhost:3000
